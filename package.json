{
  "name": "speedhockey.online",
  "packageManager": "pnpm@10.33.0",
  "version": "1.0.0",
  "scripts": {
    "build": "cross-env NODE_ENV=production parcel build assets/index.html",
    "build-dev": "cross-env NODE_ENV=development nodemon -e ts,html,css --exec 'parcel build assets/index.html && http-server dist --port 8000'",
    "format": "prettier --write src/*.ts",
    "start": "cross-env NODE_ENV=development parcel assets/index.html",
    "serve": "tsc && node --env-file=.env.production dist/server.js",
    "serve-dev": "nodemon -e ts --exec 'tsc && node --env-file=.env.development dist/server.js'"
  },
  "license": "MIT",
  "dependencies": {
    "assert-never": "^1.4.0",
    "matter-js": "^0.20.0",
    "parcel": "^2.16.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "cross-env": "^10.1.0",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "prettier-plugin-one-line-imports": "^1.0.3"
  }
}
