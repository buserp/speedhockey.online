{
  "name": "speedhockey.online",
  "packageManager": "pnpm",
  "version": "1.0.0",
  "scripts": {
    "build": "cross-env NODE_ENV=production parcel build src/index.html",
    "build-dev": "cross-env NODE_ENV=development parcel build src/index.html",
    "start": "cross-env NODE_ENV=development parcel src/index.html",
    "serve": "tsc && node --env-file=.env.production dist/server.js",
    "serve-dev": "tsc && node --env-file=.env.development dist/server.js"
  },
  "license": "MIT",
  "dependencies": {
    "excalibur": "^0.29.3",
    "matter-js": "^0.19.0",
    "parcel": "^2.16.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.8",
    "@types/node": "^20.19.41",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3"
  }
}
